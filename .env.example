# Copia este archivo como .env y escribe tus valores.
# .env NO se sube al repositorio (está en .gitignore).

# ================= API del hackathon =================
# Token del equipo: te lo da GET /equipos al tomar tu servidor.
# En el servidor del curso ya existe como $TOKEN_EQUIPO.
EQUIPO_TOKEN=

# URL base de la API del hackathon.
API_URL=https://itg.tailf75570.ts.net

# ================= Agente de IA (OpenRouter) =================
# Llave que entrega la organización.
OPENROUTER_API_KEY=

# Modelo para texto. Debe entenderse bien en español y devolver JSON.
OPENROUTER_MODEL=openai/gpt-6.1-sol

# Modelo con visión para fotos (si lo dejas vacío se usa OPENROUTER_MODEL).
OPENROUTER_MODEL_VISION=

# Modelo que acepte audio para notas de voz (si lo dejas vacío, se avisa por consola).
OPENROUTER_MODEL_AUDIO=

# ================= Telegram =================
# Token del bot que creaste con @BotFather.
TELEGRAM_BOT_TOKEN=

# chat_id del coordinador que recibe los avisos urgentes.
TELEGRAM_COORDINADOR_CHAT_ID=

# ================= Comportamiento =================
# Cada cuántos segundos se consultan mensajes nuevos.
INTERVALO_S=60

# Puerto de la aplicación web (~/app en el servidor).
PUERTO=3000

# Desde cuándo empezar a leer la primera vez (ISO 8601). Por defecto, el inicio del reto.
DESDE=2026-10-19T17:00:00-06:00

# true = solo llama a POST /casos/validar (revisa el formato, no registra ni gasta el intento).
# Ponlo en false cuando ya confíes en tu sistema.
SIMULACION=true

# true = no manda avisos a Telegram (útil mientras pruebas).
SILENCIO_TELEGRAM=false

# Carpeta donde se guarda el estado y los casos registrados.
RUTA_DATOS=.data
