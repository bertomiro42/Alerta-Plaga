# Copia este archivo como .env y escribe los valores de tu proyecto de Supabase (Project Settings).
# .env no se sube al repositorio.

# URL del proyecto, por ejemplo https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Llave publicable, empieza con sb_publishable_. En proyectos anteriores se llama llave anon.
# Nunca escribas aquí la llave secreta.
SUPABASE_PUBLISHABLE_KEY=
