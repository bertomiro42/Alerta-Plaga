{
  "name": "alerta-plaga",
  "version": "0.1.0",
  "description": "Sistema del reto «Alerta Plaga»: recibe los mensajes de los productores, los interpreta con IA, decide si son urgentes y avisa al coordinador por Telegram.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "plagas": "node --env-file-if-exists=.env src/scripts/ver-plagas.ts",
    "probar": "node --env-file-if-exists=.env src/scripts/clasificar-uno.ts",
    "modelos": "node --env-file-if-exists=.env src/scripts/listar-modelos.ts",
    "telegram": "node --env-file-if-exists=.env src/scripts/probar-telegram.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
